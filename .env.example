# Copy to .env. The app creates .env automatically on first run if it is missing.

# 32 random bytes, base64. Generate: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Do not change it once you have saved entries, or they can no longer be decrypted.
APP_KEY="PASTE_A_BASE64_32_BYTE_KEY_HERE"

# Seconds of inactivity before the vault locks (default 60, minimum 10).
IDLE_TIMEOUT=60
